# Copy this to .env and fill in real values. DO NOT commit .env.

# --- LLM / VLM ---
LLM_PROVIDER=anthropic      # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-6 # provider-specific model id
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Embeddings ---
EMBEDDING_PROVIDER=openai     # openai | gemini  (Anthropic has no embedding API)
EMBEDDING_MODEL=text-embedding-3-small
# (uses OPENAI_API_KEY or GOOGLE_API_KEY above)

# --- Storage & config (Person A) ---
# PostgreSQL connection string. src/config.py accepts the postgresql+asyncpg://
# scheme shown here and normalizes it for asyncpg itself (see Settings.asyncpg_dsn).
# Spin up a local server with docker: `docker run -d --name pg -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16`
# ...or just `docker compose up db` to use the one wired up in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/lostfound
IMAGE_STORAGE_DIR=./storage/images
MAX_IMAGE_SIZE_MB=5

# --- HTTP API & concurrency (Person B) ---
HTTP_PORT=8000
HTTP_HOST=0.0.0.0
MAX_CONCURRENT_AI_CALLS=4
RATE_LIMIT_TPM=60000

# --- Telemetry (Person C) ---
OTEL_CONSOLE_EXPORT=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Logging (shared) ---
LOG_LEVEL=INFO
